NEXT_PUBLIC_API_URL=
DATABASE_URL=postgres://user:pass@host:5432/alcremie?sslmode=require
CLOUDINARY_URL=cloudinary://key:secret@cloud

# Login do painel: sem as duas, nenhuma senha é aceita e o botão de delete
# nunca aparece. AUTH_SECRET assina o cookie de sessão (openssl rand -hex 32).
AUTH_SECRET=
AUTH_PASSWORD=
