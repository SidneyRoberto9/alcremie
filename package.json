{
  "name": "alcremie-next-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check ./src",
    "tc": "tsc --noEmit",
    "biome:fix": "biome check --write ./src",
    "biome:format": "biome format --write ./src",
    "test": "vitest run",
    "ui:score": "node tests/visual/score-ui.mjs",
    "ui:score:one": "node tests/visual/score-ui.mjs --only",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@headlessui/tailwindcss": "^0.2.0",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.10",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "prop-types": "^15.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-layout-masonry": "^1.1.0",
    "react-modern-drawer": "^1.2.2",
    "react-photo-view": "^1.2.3",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-scrollbar": "^3.0.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "onnxruntime-node": "^1.29.0",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.19",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched",
      "prettier --write --plugin prettier-plugin-tailwindcss"
    ],
    "*.json": [
      "biome format --write --no-errors-on-unmatched"
    ],
    "*.css": [
      "prettier --write"
    ]
  }
}
